generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique
  username     String   @unique
  // Expo push token for this user's device (Android only).
  // Null until the user accepts the notifications prompt;
  // cleared again if Expo reports the token as no longer registered.
  pushToken    String?
  isPremium    Boolean  @default(false)
  premiumSince DateTime?
  scoreHistory Score[]
  yearScores   UserYearScore[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedGroups    Group[]         @relation("OwnedGroups")
  memberships    GroupMember[]
  gameHighScores GameHighScore[]
  retrospectives UserRetrospective[]
}

// Source of truth for a user's score: their total for a given year is the
// sum of Score.points where year = that year. UserYearScore (below) keeps
// that sum pre-computed for leaderboards, updated in the same transaction.
model Score {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  day        Int
  points     Int
  reason     String
  itemNumber Int?
  year       Int
  earnedAt   DateTime @default(now())

  @@index([userId, year, day])
  @@index([year])
}

model UserYearScore {
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  year         Int
  total        Int      @default(0)
  lastEarnedAt DateTime // tie-breaker: at equal totals, whoever got there first ranks higher

  @@id([userId, year])
  @@index([year, total(sort: Desc), lastEarnedAt])
}

// December recap (days 1-24) shown on Dec 25th, precomputed by the /retrospective/compute cron.
model UserRetrospective {
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  year           Int
  daysOpened     Int
  openedDays     Int[]
  longestStreak  Int
  correctAnswers Int
  points         Int
  timeProfile    String   // morning | afternoon | evening | night (French time)
  computedAt     DateTime @default(now())

  @@id([userId, year])
}

// Distributions over every UserRetrospective row of a year,
// used to compare a player with the others ("plus que X % des joueurs").
model RetrospectiveStats {
  year       Int      @id
  data       Json
  computedAt DateTime @default(now())
}

model AppVersionRequirement {
  id                  Int      @id @default(1)
  // Below this version: blocking update screen.
  minSupportedVersion String
  // Below this version: dismissible update prompt.
  latestVersion       String
  // Shown in both prompts; null → the client's default text.
  updateMessage       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Group {
  id        Int           @id @default(autoincrement())
  name      String
  ownerId   Int
  owner     User          @relation("OwnedGroups", fields: [ownerId], references: [id])
  members   GroupMember[]
  createdAt DateTime      @default(now())

  @@index([ownerId])
}

model GroupMember {
  id        Int       @id @default(autoincrement())
  groupId   Int
  group     Group     @relation(fields: [groupId], references: [id])
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  addedAt   DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model GameHighScore {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  game       String   // e.g. "2048" - lets this table serve future games too
  score      Int
  achievedAt DateTime @default(now())

  @@unique([userId, game])
  @@index([game])
}

enum ContentFamily {
  story
  idea
  anecdote
  game
}

enum Season {
  christmas
  halloween
}

model Content {
  id        Int               @id @default(autoincrement())
  dayNumber Int // not unique - several rows can share a day (e.g. up to 3 games/day)
  season    Season            @default(christmas)
  type      ContentFamily
  subType   String            @default("") // fine-grained kind within type - see server/README.md
  typeTitle String            @default("") // header label shown above the content (e.g. "La recette du jour")
  title     String
  content1  String            @default("")
  content2  String            @default("")
  content3  String            @default("")
  content4  String            @default("")
  media     String            @default("")
  years     Int[]             @default([]) // years the content is shown in the app - empty = draft
  listItems ContentListItem[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([dayNumber, season])
  @@index([type, subType])
}

model ContentListItem {
  id            Int     @id @default(autoincrement())
  contentId     Int
  content       Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  order         Int // 0-based position in the list - replaces the JSON array index
  title         String
  description   String  @default("") // idea/list: description - game/quiz-*: text explanation
  author        String  @default("")
  image         String  @default("")
  url           String  @default("")
  answers       String  @default("") // game/quiz-*: comma-separated answer choices
  correctAnswer String  @default("") // game/quiz-*: the correct answer

  @@unique([contentId, order])
  @@index([contentId])
}
