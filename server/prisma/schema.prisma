generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique
  username     String   @unique
  scoreHistory Score[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedGroups Group[] @relation("OwnedGroups")
  memberships GroupMember[]
}

// No stored running total on purpose: a user's score for a given year is
// always derived by summing Score.points where year = that year. That keeps
// it impossible for a counter to drift from the rows that back it, and means
// a new calendar season needs no reset step at all - it just has no rows yet
// for that year. `year` is set explicitly at creation time (server's current
// calendar year), not derived from `earnedAt`, so past years stay queryable
// (e.g. a "last year's score" figure) without ever deleting anything.
model Score {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  day            Int
  points         Int
  reason         String
  questionNumber Int?
  year           Int
  earnedAt       DateTime @default(now())

  @@index([userId, year, day])
  @@index([year])
}

model AppConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Group {
  id        Int           @id @default(autoincrement())
  name      String
  ownerId   Int
  owner     User          @relation("OwnedGroups", fields: [ownerId], references: [id])
  members   GroupMember[]
  createdAt DateTime      @default(now())

  @@index([ownerId])
}

model GroupMember {
  id        Int       @id @default(autoincrement())
  groupId   Int
  group     Group     @relation(fields: [groupId], references: [id])
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  addedAt   DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

enum ContentFamily {
  story
  idea
  anecdote
  game
}

enum Season {
  christmas
  halloween
}

model Content {
  id        Int               @id @default(autoincrement())
  dayNumber Int // not unique - several rows can share a day (e.g. up to 3 games/day)
  season    Season            @default(christmas)
  type      ContentFamily
  subType   String            @default("") // fine-grained kind within type - see server/README.md
  title     String
  content1  String            @default("")
  content2  String            @default("")
  content3  String            @default("")
  content4  String            @default("")
  media     String            @default("")
  published Boolean           @default(true)
  isNew     Boolean           @default(false) @map("new")
  listItems ContentListItem[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([dayNumber, season])
  @@index([type, subType])
}

model ContentListItem {
  id          Int     @id @default(autoincrement())
  contentId   Int
  content     Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  order       Int // 0-based position in the list - replaces the JSON array index
  title       String
  description String  @default("")
  author      String  @default("")
  image       String  @default("")
  url         String  @default("")

  @@unique([contentId, order])
  @@index([contentId])
}
