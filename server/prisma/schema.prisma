generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique
  username     String   @unique
  score        Int      @default(0)
  scoreHistory Score[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedGroups Group[] @relation("OwnedGroups")
  memberships GroupMember[]
}

model Score {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  day            Int
  points         Int
  reason         String
  questionNumber Int?
  earnedAt       DateTime @default(now())

  @@index([userId, day])
  @@index([userId, reason])
}

model AppConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Group {
  id        Int           @id @default(autoincrement())
  name      String
  ownerId   Int
  owner     User          @relation("OwnedGroups", fields: [ownerId], references: [id])
  members   GroupMember[]
  createdAt DateTime      @default(now())

  @@index([ownerId])
}

model GroupMember {
  id        Int       @id @default(autoincrement())
  groupId   Int
  group     Group     @relation(fields: [groupId], references: [id])
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  addedAt   DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

enum ContentFamily {
  story
  idea
  anecdote
  game
}

model Content {
  id        Int               @id @default(autoincrement())
  dayNumber Int // not unique - several rows can share a day (e.g. up to 3 games/day)
  type      ContentFamily
  subType   String            @default("") // fine-grained kind within type - see server/README.md
  title     String
  content1  String            @default("")
  content2  String            @default("")
  content3  String            @default("")
  content4  String            @default("")
  media     String            @default("")
  published Boolean           @default(true)
  isNew     Boolean           @default(false) @map("new")
  listItems ContentListItem[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([dayNumber])
  @@index([type, subType])
}

model ContentListItem {
  id          Int     @id @default(autoincrement())
  contentId   Int
  content     Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  order       Int // 0-based position in the list - replaces the JSON array index
  title       String
  description String  @default("")
  author      String  @default("")
  image       String  @default("")
  url         String  @default("")

  @@unique([contentId, order])
  @@index([contentId])
}
