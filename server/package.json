{
    "name": "advent-calendar",
    "version": "0.0.1",
    "description": "Awesome project developed with TypeORM.",
    "type": "commonjs",
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/node": "^20.11.0",
        "nodemon": "^3.1.7",
        "prisma": "^6.15.0",
        "rimraf": "^6.0.1",
        "ts-node": "10.9.1",
        "typescript": "^5.9.2"
    },
    "dependencies": {
        "@notionhq/client": "^5.24.0",
        "@prisma/client": "^6.15.0",
        "@sentry/node": "^10.69.0",
        "body-parser": "^1.19.1",
        "cors": "^2.8.5",
        "dotenv": "^17.4.2",
        "express": "^4.17.2"
    },
    "scripts": {
        "dev": "nodemon src/server.ts",
        "build": "rimraf dist && tsc",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate deploy",
        "prisma:seed:appconfig": "ts-node prisma/seeds/appconfig.seeds.ts",
        "migrate:contents-to-postgres": "ts-node scripts/migrateContentsToPostgres.ts",
        "admin:hash-password": "ts-node scripts/hashAdminPassword.ts",
        "pwa:hash-code": "ts-node scripts/hashPwaAccessCode.ts",
        "db:setup": "npm run prisma:generate && npm run prisma:migrate && npm run prisma:seed:appconfig",
        "postinstall": "prisma generate",
        "start": "node dist/index.js",
        "ts.check": "tsc --project tsconfig.json",
        "test": "echo \"Error: no test specified\" && exit 1"
    }
}
