{
    "cli": {
        "version": ">= 12.6.2",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "channel": "development"
        },
        "preview": {
            "distribution": "internal",
            "channel": "preview",
            "android": {
                "buildType": "apk"
            },
            "env": {
                "EXPO_PUBLIC_API_URL_PROD": "https://advent-calendar-v3.vercel.app"
            }
        },
        "production": {
            "autoIncrement": true,
            "channel": "production",
            "android": {
                "buildType": "app-bundle"
            },
            "env": {
                "SENTRY_ORG": "mon-calendrier-de-lavent",
                "SENTRY_PROJECT": "react-native"
            }
        }
    },
    "submit": {
        "production": {}
    }
}
