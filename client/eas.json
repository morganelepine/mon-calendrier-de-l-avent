{
    "cli": {
        "version": ">= 12.6.2",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "channel": "development"
        },
        "preview": {
            "distribution": "internal",
            "channel": "preview",
            "android": {
                "buildType": "apk"
            },
            "env": {
                "EXPO_PUBLIC_API_URL_PROD": "https://advent-calendar-v3.vercel.app",
                "EXPO_PUBLIC_PREMIUM_ENABLED": "true"
            }
        },
        "closed-testing": {
            "extends": "production",
            "channel": "closed-testing",
            "env": {
                "SENTRY_ORG": "mon-calendrier-de-lavent",
                "SENTRY_PROJECT": "react-native",
                "EXPO_PUBLIC_PREMIUM_ENABLED": "true"
            }
        },
        "production": {
            "autoIncrement": true,
            "channel": "production",
            "android": {
                "buildType": "app-bundle"
            },
            "env": {
                "SENTRY_ORG": "mon-calendrier-de-lavent",
                "SENTRY_PROJECT": "react-native",
                "EXPO_PUBLIC_PREMIUM_ENABLED": "false"
            }
        }
    },
    "submit": {
        "production": {},
        "closed-testing": {
            "android": {
                "track": "alpha"
            }
        }
    }
}
