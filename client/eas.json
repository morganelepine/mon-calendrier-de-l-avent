{
    "cli": {
        "version": ">= 12.6.2",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal"
        },
        "preview": {
            "distribution": "internal"
        },
        "production": {
            "autoIncrement": true
        },
        "prod-test-apk": {
            "distribution": "internal",
            "android": { "buildType": "apk" },
            "env": {
                "EXPO_PUBLIC_API_URL_PROD": "https://advent-calendar-v3.vercel.app",
                "EXPO_PUBLIC_API_URL_DEV": "http://192.168.1.18:3000"
            }
        }
    },
    "submit": {
        "production": {}
    }
}
