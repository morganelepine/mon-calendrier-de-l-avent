{
    "expo": {
        "name": "Calendrier de l'avent",
        "slug": "advent-calendar",
        "version": "1.4.3",
        "newArchEnabled": true,
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "myapp",
        "userInterfaceStyle": "automatic",
        "splash": {
            "image": "./assets/images/splash.png",
            "resizeMode": "contain",
            "backgroundColor": "#f7f5f6"
        },
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "package": "com.merrymate.moncalendrierdelavent",
            "googleServicesFile": "./google-services.json",
            "adaptiveIcon": {
                "foregroundImage": "./assets/images/adaptive-icon.png",
                "backgroundColor": "#0b2956"
            },
            "permissions": [
                "android.permission.RECORD_AUDIO",
                "android.permission.MODIFY_AUDIO_SETTINGS"
            ]
        },
        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "expo-router",
            "expo-font",
            "expo-audio",
            "expo-web-browser",
            "expo-asset",
            [
                "expo-notifications",
                {
                    "icon": "./assets/images/notification-icon.png",
                    "color": "#a0222d"
                }
            ],
            [
                "react-native-android-widget",
                {
                    "fonts": [
                        "./assets/fonts/FreightNeo/Fonts/FreightNeo W03 Bold.ttf",
                        "./assets/fonts/FreightNeo/Fonts/FreightNeo W03 Semi.ttf"
                    ],
                    "widgets": [
                        {
                            "name": "HouseCountdown",
                            "label": "Maisonnette",
                            "description": "Le nombre de nuits avant Noël",
                            "previewImage": "./assets/images/widget/house-preview.webp",
                            "minWidth": "40dp",
                            "minHeight": "100dp",
                            "targetCellWidth": 1,
                            "targetCellHeight": 2,
                            "updatePeriodMillis": 1800000,
                            "resizeMode": "vertical"
                        },
                        {
                            "name": "SnowballCountdown",
                            "label": "Boule à neige",
                            "description": "Le nombre de nuits avant Noël",
                            "previewImage": "./assets/images/widget/snowball-preview.webp",
                            "minWidth": "100dp",
                            "minHeight": "100dp",
                            "targetCellWidth": 2,
                            "targetCellHeight": 2,
                            "updatePeriodMillis": 1800000,
                            "resizeMode": "horizontal|vertical"
                        },
                        {
                            "name": "GiftsCountdown",
                            "label": "Cadeaux de Noël",
                            "description": "Les jours et les heures avant Noël",
                            "previewImage": "./assets/images/widget/gifts-preview.webp",
                            "minWidth": "100dp",
                            "minHeight": "250dp",
                            "targetCellWidth": 2,
                            "targetCellHeight": 4,
                            "updatePeriodMillis": 1800000,
                            "resizeMode": "vertical"
                        }
                    ]
                }
            ],
            [
                "@sentry/react-native/expo",
                {
                    "url": "https://sentry.io/",
                    "organization": "mon-calendrier-de-lavent",
                    "project": "react-native"
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true
        },
        "extra": {
            "eas": {
                "projectId": "dd51463c-9f71-4352-bc81-5a8c2a8a0a7d"
            }
        },
        "runtimeVersion": {
            "policy": "appVersion"
        },
        "updates": {
            "url": "https://u.expo.dev/dd51463c-9f71-4352-bc81-5a8c2a8a0a7d",
            "enabled": true,
            "checkAutomatically": "ON_LOAD",
            "fallbackToCacheTimeout": 0,
            "requestHeaders": {
                "expo-branch-name": "production"
            }
        }
    }
}
